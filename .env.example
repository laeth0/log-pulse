# -----------------------------------------------------------------------
# Log Pulse — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit the real .env to version control.
# -----------------------------------------------------------------------

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=replace_with_a_local_password
DB_NAME=log_pulse

# Set to "true" to enable SSL (e.g. for cloud-managed databases)
DB_SSL=false

# Connection pool
DB_POOL_MAX=20
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000

# Application
NODE_ENV=development
# Keep this at 8080 for the project load generator.
API_HOST_PORT=8080
PORT=8080
# Transport limit in bytes (50 MiB by default). This is not a logs-entry limit.
HTTP_BODY_LIMIT_BYTES=52428800

# Internal database insert chunk size. The entire accepted request is atomic.
LOG_INGEST_CHUNK_SIZE=1000

# Hourly retention job. Defaults support deleting slightly more than 500 logs/sec.
LOG_RETENTION_CRON=0 0 * * * *
LOG_RETENTION_DAYS=30
LOG_RETENTION_BATCH_SIZE=5000
LOG_RETENTION_MAX_BATCHES=400
LOG_RETENTION_MAX_RUN_MS=3300000
