# -----------------------------------------------------------------------
# Log Pulse — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit the real .env to version control.
# -----------------------------------------------------------------------

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=4087
DB_NAME=log_pulse

# Set to "true" to enable SSL (e.g. for cloud-managed databases)
DB_SSL=false

# Connection pool (leave blank to use pg defaults)
# DB_POOL_MAX=10
# DB_CONNECTION_TIMEOUT_MS=30000
# DB_IDLE_TIMEOUT_MS=10000

# Application
NODE_ENV=development
PORT=8080

# Retention policy — logs older than this many days will be deleted by the background job
LOG_RETENTION_ENABLED=true
LOG_RETENTION_DAYS=30
LOG_RETENTION_BATCH_SIZE=1000
LOG_RETENTION_MAX_BATCHES=10
