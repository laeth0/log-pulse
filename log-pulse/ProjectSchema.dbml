// Log Pulse — Database Schema
// PostgreSQL · TypeORM · Generated from log.entity.ts
// https://dbml.org/docs

Project log_pulse {
  database_type: 'PostgreSQL'
  Note: '''
    Log Ingestion & Query Service.
    Accepts high-volume structured logs, stores them efficiently,
    and exposes filtering, aggregation, and cursor-paginated queries.
  '''
}

// ---------------------------------------------------------------------------
// Enum: log severity level
// ---------------------------------------------------------------------------

Enum logs_level_enum {
  debug [note: 'Verbose diagnostic output']
  info  [note: 'Normal operational messages']
  warn  [note: 'Potentially harmful situations']
  error [note: 'Error events that might still allow the app to continue']
}

// ---------------------------------------------------------------------------
// Table: logs
// ---------------------------------------------------------------------------

Table logs {
  id         bigint      [pk, increment, note: 'Surrogate PK; used as keyset-pagination cursor base']
  timestamp  timestamptz [not null, note: 'Client-supplied event time (ISO 8601). Rejected if >5 min in the future.']
  level      logs_level_enum [not null, note: 'Severity level — one of debug | info | warn | error']
  service    varchar(255) [not null, note: 'Name of the originating service (non-empty)']
  message    text        [not null, note: 'Human-readable log message (non-empty). Supports case-insensitive substring search via q param.']
  attributes jsonb       [not null, default: '{}', note: 'Flat key/value metadata bag. Values are string | number | boolean. No nested objects.']
  created_at timestamptz [not null, default: `now()`, note: 'Wall-clock DB insert time — used for ingestion latency monitoring, not exposed in the public API.']

  indexes {
    (service, timestamp) [
      name: 'idx_logs_service_timestamp',
      note: 'B-tree index serving service equality combined with time-range filters.'
    ]

    (level, timestamp) [
      name: 'idx_logs_level_timestamp',
      note: 'B-tree index serving level equality combined with time-range filters.'
    ]

    (timestamp, id) [
      name: 'idx_logs_timestamp_id_desc',
      note: 'Descending B-tree index on both columns. Serves stable keyset pagination and time-range aggregation scans.'
    ]

    message [
      name: 'idx_logs_message_trgm',
      type: gin,
      note: 'PostgreSQL GIN index using gin_trgm_ops. Serves case-insensitive ILIKE substring filters.'
    ]
  }

  Note: '''
    Core log storage table.

    Schema decisions:
    - BIGINT PK keeps the clustered index narrow at million-plus row counts.
    - `timestamp` is a plain column (not generated) so the client-supplied
      event time is preserved, independent of insert time.
    - `attributes` is jsonb so arbitrary keys can be filtered with
      attributes->>''key'' = ''value'' without a separate EAV table.
    - Composite indexes on (service, timestamp) and (level, timestamp) cover
      common equality-plus-time query patterns.
    - (timestamp DESC, id DESC) matches cursor pagination ordering and supports
      date_bin aggregation range scans.
    - The pg_trgm extension supplies gin_trgm_ops for the message GIN index.
  '''
}
