// Log Pulse — Database Schema
// PostgreSQL · TypeORM · Generated from log.entity.ts
// https://dbml.org/docs

Project log_pulse {
  database_type: 'PostgreSQL'
  Note: '''
    Log Ingestion & Query Service.
    Accepts high-volume structured logs, stores them efficiently,
    and exposes filtering, aggregation, and cursor-paginated queries.
  '''
}

// ---------------------------------------------------------------------------
// Enum: log severity level
// ---------------------------------------------------------------------------

Enum logs_level_enum {
  debug [note: 'Verbose diagnostic output']
  info  [note: 'Normal operational messages']
  warn  [note: 'Potentially harmful situations']
  error [note: 'Error events that might still allow the app to continue']
}

// ---------------------------------------------------------------------------
// Table: logs
// ---------------------------------------------------------------------------

Table logs {
  id         uuid        [pk, not null, default: `gen_random_uuid()`, note: 'Database-generated UUID; represented as a string in TypeScript and the API']
  timestamp  timestamptz [not null, note: 'Client-supplied event time (ISO 8601). Rejected if >5 min in the future.']
  level      logs_level_enum [not null, note: 'Severity level — one of debug | info | warn | error']
  service    text        [not null, note: 'Name of the originating service (non-empty; no invented 255-character cap)']
  message    text        [not null, note: 'Human-readable log message (non-empty). Supports case-insensitive substring search via q param.']
  attributes jsonb       [not null, default: '{}', note: 'Flat key/value metadata bag. Values are string | number | boolean. No nested objects.']
  created_at timestamptz [not null, default: `now()`, note: 'Wall-clock DB insert time — used for ingestion latency monitoring, not exposed in the public API.']

  indexes {
    (timestamp, id) [
      name: 'idx_logs_timestamp_id',
      note: 'B-tree supporting retention scans, time ranges, aggregation, and stable keyset pagination in either scan direction.'
    ]

    (service, timestamp, id) [
      name: 'idx_logs_service_timestamp_id',
      note: 'B-tree for service equality followed by time ranges and stable timestamp/id ordering.'
    ]

    (level, timestamp, id) [
      name: 'idx_logs_level_timestamp_id',
      note: 'B-tree for level equality followed by time ranges and stable timestamp/id ordering.'
    ]

    message [
      name: 'idx_logs_message_trgm',
      type: gin,
      note: 'GIN using gin_trgm_ops for literal case-insensitive substring filters.'
    ]

  }

  Note: '''
    Core log storage table.

    Schema decisions:
    - UUID PK provides opaque public identifiers generated by PostgreSQL.
    - `timestamp` is a plain column (not generated) so the client-supplied
      event time is preserved, independent of insert time.
    - CHECK constraints require non-empty service and message values.
    - The baseline migration creates the table and primary key. Subsequent
      versioned migrations create every secondary index listed above.
    - Schema synchronization is disabled; migrations are the source of truth.
    - The pgcrypto extension supplies UUID generation on PostgreSQL versions
      where `gen_random_uuid()` is not built in.
    - The pg_trgm extension is installed as a prerequisite for the message
      index.
  '''
}
