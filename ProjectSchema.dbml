// Log Pulse — Database Schema
// PostgreSQL · TypeORM · Generated from log.entity.ts
// https://dbml.org/docs

Project log_pulse {
  database_type: 'PostgreSQL'
  Note: '''
    Log Ingestion & Query Service.
    Accepts high-volume structured logs, stores them efficiently,
    and exposes filtering, aggregation, and cursor-paginated queries.
  '''
}

// ---------------------------------------------------------------------------
// Enum: log severity level
// ---------------------------------------------------------------------------

Enum logs_level_enum {
  debug [note: 'Verbose diagnostic output']
  info  [note: 'Normal operational messages']
  warn  [note: 'Potentially harmful situations']
  error [note: 'Error events that might still allow the app to continue']
}

// ---------------------------------------------------------------------------
// Table: logs
// ---------------------------------------------------------------------------

Table logs {
  id         bigint      [pk, increment, note: 'GENERATED BY DEFAULT AS IDENTITY; represented as a decimal string in TypeScript and the API']
  timestamp  timestamptz [not null, note: 'Client-supplied event time (ISO 8601). Rejected if >5 min in the future.']
  level      logs_level_enum [not null, note: 'Severity level — one of debug | info | warn | error']
  service    text        [not null, note: 'Name of the originating service (non-empty; no invented 255-character cap)']
  message    text        [not null, note: 'Human-readable log message (non-empty). Supports case-insensitive substring search via q param.']
  attributes jsonb       [not null, default: '{}', note: 'Flat key/value metadata bag. Values are string | number | boolean. No nested objects.']
  attributes_text jsonb  [not null, note: 'Stored generated projection from log_attributes_to_text(attributes); all scalar values are JSON strings and the column is internal']
  created_at timestamptz [not null, default: `now()`, note: 'Wall-clock DB insert time — used for ingestion latency monitoring, not exposed in the public API.']

  indexes {
    (timestamp, id) [
      name: 'idx_logs_timestamp_id',
      note: 'Candidate descending B-tree for stable keyset pagination, range scans, aggregation, and retention; final inclusion requires EXPLAIN evidence.'
    ]

    (`md5(service)`, timestamp, id) [
      name: 'idx_logs_service_hash_timestamp_id',
      note: 'Candidate B-tree with residual exact service equality; avoids a key-size contract cap. Final inclusion requires EXPLAIN evidence.'
    ]

    (level, timestamp, id) [
      name: 'idx_logs_level_timestamp_id',
      note: 'Candidate B-tree for level plus time/cursor patterns. Final inclusion requires EXPLAIN evidence.'
    ]

    message [
      name: 'idx_logs_message_trgm',
      type: gin,
      note: 'Candidate GIN using gin_trgm_ops for literal case-insensitive substring filters. Final inclusion requires EXPLAIN evidence.'
    ]

    attributes_text [
      name: 'idx_logs_attributes_text_gin',
      type: gin,
      note: 'Candidate GIN using jsonb_path_ops for normalized attribute containment. Final inclusion requires EXPLAIN evidence.'
    ]
  }

  Note: '''
    Core log storage table.

    Schema decisions:
    - BIGINT PK keeps the clustered index narrow at million-plus row counts.
    - `timestamp` is a plain column (not generated) so the client-supplied
      event time is preserved, independent of insert time.
    - CHECK constraints require non-empty service/message and flat scalar
      attributes through log_attributes_are_flat_scalars(attributes).
    - `attributes_text` is generated by log_attributes_to_text(attributes) and
      enables string-equality semantics without losing response value types.
    - The baseline migration currently creates only the primary key. Every
      secondary index listed above is a candidate pending EXPLAIN (ANALYZE,
      BUFFERS) and load evidence; the final schema sync occurs after that review.
    - The pg_trgm extension is installed as a prerequisite for the candidate
      message index.
  '''
}
